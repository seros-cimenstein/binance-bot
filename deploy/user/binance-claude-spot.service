[Unit]
Description=Binance Claude Autonomous Spot Cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/binance-bot
EnvironmentFile=%h/.local/share/binance-bot/.env
ExecStart=%h/.local/share/binance-bot/venv/bin/python -m src.claude_spot --submit-live
StandardOutput=journal
StandardError=journal
