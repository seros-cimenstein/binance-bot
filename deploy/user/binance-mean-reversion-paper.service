[Unit]
Description=Binance Mean-Reversion Paper Daemon
After=network-online.target
Wants=network-online.target

[Service]
# Long-running daemon: polls Binance 1m klines for the configured
# universe every cycle_interval_seconds, fires dump-buy / retrace-sell
# decisions, materialises them in local state, writes round-trips to a
# JSONL ledger. No real orders.
Type=simple
WorkingDirectory=%h/.local/share/binance-bot
EnvironmentFile=%h/.local/share/binance-bot/.env
ExecStart=%h/.local/share/binance-bot/venv/bin/python -m src.mean_reversion --paper --daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
