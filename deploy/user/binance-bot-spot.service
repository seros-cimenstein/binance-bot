[Unit]
Description=Binance Bot Spot algorithm trader (cycle every 20 minutes until Phase 52 D7)
After=network-online.target
Wants=network-online.target

[Service]
# Long-running daemon: the operator's rule decides once every --interval-seconds. SIGTERM finishes any in-flight route before exiting.
Type=simple
WorkingDirectory=%h/.local/share/binance-bot
EnvironmentFile=%h/.local/share/binance-bot/.env
ExecStart=%h/.local/share/binance-bot/bin/bb bot-spot --submit-live --daemon --interval-seconds 1200
Restart=always
RestartSec=30
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
