[Unit]
Description=Binance Bot Agentic Spot Trader (omp session, cycle every 20 minutes)
After=network-online.target
Wants=network-online.target

[Service]
# Long-running daemon: one persistent omp RPC session; a decision cycle every
# --interval-seconds. SIGTERM finishes any in-flight route before exiting.
Type=simple
WorkingDirectory=%h/.local/share/binance-bot
EnvironmentFile=%h/.local/share/binance-bot/.env
ExecStart=%h/.local/share/binance-bot/bin/bb bot-spot --submit-live --daemon --interval-seconds 1200
Restart=always
RestartSec=30
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
