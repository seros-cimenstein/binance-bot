[Unit]
Description=Binance Bot Spot nonstop algorithm trader
After=network-online.target
Wants=network-online.target

[Service]
# Nonstop: polls prices every 15 s and decides with the operator's rule; a decision row on change plus one an hour. SIGTERM finishes any in-flight route before exiting.
Type=simple
WorkingDirectory=%h/.local/share/binance-bot
EnvironmentFile=%h/.local/share/binance-bot/.env
ExecStart=%h/.local/share/binance-bot/bin/bb bot-spot --submit-live --nonstop
Restart=always
RestartSec=30
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
