[Unit]
Description=Run Binance Listing Detector every 2 minutes

[Timer]
# Polls the announcements API every 2 minutes. Default --detect-only mode
# audits new spot listings to data/listing-detector-events.jsonl without
# trading. Switch to --submit-live in ExecStart after PROVEN_EDGE gate is set.
OnBootSec=2min
OnActiveSec=2min
OnUnitActiveSec=2min
AccuracySec=15s
Persistent=false
Unit=binance-listing-detector.service

[Install]
WantedBy=timers.target
