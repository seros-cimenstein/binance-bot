[Unit]
Description=Backup Binance Paper Pool SQLite ledger (User Service)
After=local-fs.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/binance-bot
Environment=BINANCE_BOT_BACKUP_RETENTION=35
Environment=BINANCE_BOT_DB_SETTING_KEY=POOL_DB_PATH
Environment=BINANCE_BOT_DB_DEFAULT_PATH=data/pool-paper.db
ExecStart=%h/.local/share/binance-bot/scripts/backup_db.sh
