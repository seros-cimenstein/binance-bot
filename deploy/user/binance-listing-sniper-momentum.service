[Unit]
Description=Binance Listing Sniper (paper, momentum hold)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/binance-bot
EnvironmentFile=%h/.local/share/binance-bot/.env
Environment=LISTING_SNIPER_HOLD_MODE=momentum
Environment=LISTING_SNIPER_STATE_PATH=%h/.local/share/binance-bot/data/listing-sniper-momentum-state.json
Environment=LISTING_SNIPER_AUDIT_PATH=%h/.local/share/binance-bot/data/listing-sniper-momentum-events.jsonl
Environment=LISTING_SNIPER_LEDGER_PATH=%h/.local/share/binance-bot/data/listing-sniper-momentum-ledger.jsonl
Environment=LISTING_SNIPER_EMERGENCY_STOP_PATH=%h/.local/share/binance-bot/data/listing-sniper-momentum.stop
ExecStart=%h/.local/share/binance-bot/venv/bin/python -m src.listing_sniper --paper --daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
