[Unit]
Description=Binance Bot — daily airdrop reminder (snapshot + Telegram digest)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/binance-bot
EnvironmentFile=%h/.local/share/binance-bot/.env
ExecStart=%h/.local/share/binance-bot/venv/bin/python -m src.airdrop.scheduler remind
StandardOutput=journal
StandardError=journal
