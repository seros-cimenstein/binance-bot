[Unit]
Description=Binance Solana Sniper Forward Paper Daemon
After=network-online.target
Wants=network-online.target

[Service]
# Long-running daemon (not oneshot): subscribes to Solana log feeds,
# decodes pump.fun CreateEvents, scores, simulates Jupiter buys + N-sec
# holds + Jupiter sells. Writes round-trips to a JSONL ledger.
Type=simple
WorkingDirectory=%h/.local/share/binance-bot
EnvironmentFile=%h/.local/share/binance-bot/.env
ExecStart=%h/.local/share/binance-bot/bin/bb sniper-paper \
  --entry-sol 0.005 \
  --hold-seconds 300 \
  --slippage-bps 500 \
  --max-concurrent 5 \
  --ledger-path %h/.local/share/binance-bot/data/sniper-paper-ledger.jsonl \
  --summary-path %h/.local/share/binance-bot/data/sniper-paper-summary.json
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
