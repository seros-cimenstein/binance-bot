[Unit]
Description=Binance Long-Horizon Trend Filter Cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/binance-bot
EnvironmentFile=%h/.local/share/binance-bot/.env
ExecStart=%h/.local/share/binance-bot/bin/bb trend-filter --submit-live
StandardOutput=journal
StandardError=journal
