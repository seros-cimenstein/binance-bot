[Unit]
Description=Run Binance Trend Filter Cycle daily

[Timer]
# Run daily at 00:30 UTC. The runtime itself enforces the configured
# rebalance cadence (TREND_FILTER_REBALANCE_EVERY_DAYS) and returns
# skip_cycle on days within the holding window — daily polling keeps
# the audit fresh and catches any missed rebalance windows.
OnCalendar=*-*-* 00:30:00 UTC
AccuracySec=1m
Persistent=true
Unit=binance-trend-filter.service

[Install]
WantedBy=timers.target
