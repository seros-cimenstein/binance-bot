[Unit]
Description=Binance Listing Sniper Daemon
After=network-online.target
Wants=network-online.target

[Service]
# Long-running daemon: polls /api/v3/exchangeInfo every poll_interval_seconds
# and detects the moment a new USDT pair enters TRADING status. Default
# mode is --paper so the deploy is safe out of the box; flip ExecStart to
# --submit-live after the gate ladder + paper expectancy validates.
Type=simple
WorkingDirectory=%h/.local/share/binance-bot
EnvironmentFile=%h/.local/share/binance-bot/.env
ExecStart=%h/.local/share/binance-bot/venv/bin/python -m src.listing_sniper --paper --daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
