[Unit]
Description=Run Binance Funding-Arb Cycle aligned to Binance USD-M funding windows

[Timer]
# Binance USD-M perp funding settles at 00:00, 08:00, 16:00 UTC. Fire one
# minute after each window so the just-applied funding rate is captured.
OnCalendar=*-*-* 00,08,16:01:00 UTC
AccuracySec=30s
Persistent=true
Unit=binance-funding-arb.service

[Install]
WantedBy=timers.target
