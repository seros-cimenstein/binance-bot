[Unit]
Description=Binance Funding-Arb Delta-Neutral Cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/binance-bot
EnvironmentFile=%h/.local/share/binance-bot/.env
ExecStart=%h/.local/share/binance-bot/bin/bb funding-arb --paper
StandardOutput=journal
StandardError=journal
