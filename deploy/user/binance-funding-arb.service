[Unit]
Description=Binance Funding-Arb Delta-Neutral Cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/binance-bot
EnvironmentFile=%h/.local/share/binance-bot/.env
ExecStart=%h/.local/share/binance-bot/venv/bin/python -m src.funding_arb --paper
StandardOutput=journal
StandardError=journal
