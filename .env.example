# Binance credentials
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Market and strategy
TRADING_SYMBOL=BTC/USDT
# Optional comma-separated replacement for TRADING_SYMBOL.
TRADING_SYMBOLS=
TRADING_TIMEFRAME=1m
ORDER_SIZE=0.001
ORDER_SIZE_MODE=fixed
ORDER_SIZE_PERCENT=1
MIN_ORDER_NOTIONAL_USD=0
MAX_ORDER_NOTIONAL_USD=0
MIN_BALANCE_USDT=0
STRATEGY=demo-sma
SMA_FAST_PERIOD=20
SMA_SLOW_PERIOD=50

# Runtime mode
USE_TESTNET=true
DRY_RUN=false

# Set to "yes" only when switching to a real-money account.
CONFIRM_LIVE_TRADING=no

# Local API-key scope guard. Binance does not expose the full symbol whitelist
# through safe diagnostics, so live-capable features fail closed when a symbol
# or asset is outside these operator-owned lists.
API_SYMBOL_WHITELIST=
API_ASSET_WHITELIST=

# Manual one-shot live probe writes audit rows here when explicitly confirmed.
LIVE_PROBE_AUDIT_PATH=data/live-probes.jsonl

# Foreground spot live canary defaults. It still requires CLI confirmation
# flags before it can submit one real order.
SPOT_CANARY_AUDIT_PATH=data/spot-canary.jsonl
SPOT_CANARY_STOP_PATH=data/spot-canary.stop

# Foreground guarded live spot allocator defaults. It still requires CLI
# confirmation flags before it can submit one real order.
LIVE_SPOT_ALLOCATOR_AUDIT_PATH=data/live-spot-allocations.jsonl
LIVE_SPOT_ALLOCATOR_STOP_PATH=data/live-spot.stop

# Claude agentic Spot trader (`bb claude-spot`). Disabled by default. Claude runs
# through omp in RPC mode with a persistent session (context survives restarts)
# and acts only through the bot's host tools. When live it may use the whole
# Spot wallet; there are no edge/friction/cooldown/daily-cap gates — costs are
# information Claude weighs. Hard safety always applies: the arming flags below,
# the stop file, Binance order/test before every leg, per-leg fill
# reconciliation, and the failed-route halt (clear with
# `bb claude-spot --mark-failed-route-reviewed`).
CLAUDE_SPOT_ENABLED=false
CLAUDE_SPOT_DYNAMIC_SCOPE=
CLAUDE_SPOT_COMMAND=omp
# Use provider/model ids: a bare "gpt-6.1-sol" can resolve to another provider (e.g. github-copilot).
# Deployed: openai-codex/gpt-6.1-sol at high (operator decision 2026-10-16; was
# anthropic/claude-sonnet-5-5 from 2026-10-14, claude-haiku-5-5 before).
CLAUDE_SPOT_MODEL=openai-codex/gpt-6.1-sol
# off, minimal, low, medium, high, xhigh, max
CLAUDE_SPOT_THINKING=high
# omp built-in web_search alongside the bot's tools (news, catalysts). Results are untrusted data.
CLAUDE_SPOT_WEB_SEARCH=true
CLAUDE_SPOT_TIMEOUT_SECONDS=300
# Bot-owned model failover (empty = none, behavior unchanged). Comma list of
# provider/model-id[:thinking]; omitted thinking = CLAUDE_SPOT_THINKING. A turn
# that failed (timeout, error, crash, rate/usage limit) WITHOUT an execute_route
# call is retried once per remaining model; a failed compaction moves to the next
# model too. Operator-approved chain (CODEX.md, 2026-10-16), each on its own omp login:
# gpt-6.1-sol (OpenAI Codex) -> Gemini 4 Argon (Google Antigravity). omp 18.8 names
# Argon by thinking tier (gemini-4-argon-high); newer omp catalogs list gemini-4-argon.
CLAUDE_SPOT_FALLBACK_MODELS=google-antigravity/gemini-4-argon-high:high
# Primary per-attempt timeout while fallbacks exist (fallbacks use CLAUDE_SPOT_TIMEOUT_SECONDS).
CLAUDE_SPOT_PRIMARY_TIMEOUT_SECONDS=150
# Stay on a fallback this long, then try the primary again at the next cycle start.
CLAUDE_SPOT_FALLBACK_COOLDOWN_SECONDS=1800
# Telegram alert after this many consecutive cycles failed on every model (0 = never).
CLAUDE_SPOT_BRAIN_DOWN_ALERT_CYCLES=3
CLAUDE_SPOT_PROMPT_VERSION=claude-spot-v11-agentic
CLAUDE_SPOT_SESSION_DIR=data/claude-spot-session
CLAUDE_SPOT_JOURNAL_PATH=data/claude-spot-journal.jsonl
CLAUDE_SPOT_JOURNAL_PROMPT_ENTRIES=8
CLAUDE_SPOT_STATE_PATH=data/claude-spot-agent-state.json
# Compact the omp session when context usage passes this percent of the model's window,
# or (CLAUDE_SPOT_COMPACT_AT_TOKENS > 0) holds that many tokens, whichever comes first.
# The token threshold keeps one context size across models with 272K-1M windows.
CLAUDE_SPOT_COMPACT_AT_PERCENT=70
CLAUDE_SPOT_COMPACT_AT_TOKENS=100000
# LLM spend cap per UTC day in USD (0 = unlimited). Cost control, not a trading gate.
CLAUDE_SPOT_MAX_DAILY_LLM_COST_USD=0
# Routes older than this are re-quoted before execute_route.
CLAUDE_SPOT_ROUTE_STALE_SECONDS=60
CLAUDE_SPOT_AUDIT_PATH=data/claude-spot-decisions.jsonl
CLAUDE_SPOT_LOCK_PATH=data/claude-spot.lock
CLAUDE_SPOT_STOP_PATH=data/claude-spot.stop
# Phase 45 exit-plan paper trial: plans set by Claude (set_exit_plan), and the
# state/log written by `bb claude-spot-exit-watch` (paper only, places no orders).
CLAUDE_SPOT_EXIT_PLANS_PATH=data/claude-spot-exit-plans.json
CLAUDE_SPOT_EXIT_WATCH_STATE_PATH=data/claude-spot-exit-watch-state.json
CLAUDE_SPOT_EXIT_WATCH_LOG_PATH=data/claude-spot-exit-watch.jsonl
# Live exit plans (operator approval 2026-10-15): with --submit-live --daemon the trader
# follows the bid of every position with a plan between cycles and SELLS it into USDT when
# the plan fires (same hard safety as execute_route). false = paper (claude-spot-exit-watch).
CLAUDE_SPOT_EXIT_PLANS_LIVE=false
# Plan for every position opened at or after ..._FROM unless Claude sets another (blank = none).
# Backtest winner 2026-10-15: sell all at the 2-sigma stretch, 3 x 1h ATR safety trail.
CLAUDE_SPOT_DEFAULT_EXIT_PLAN=
CLAUDE_SPOT_DEFAULT_EXIT_PLAN_FROM=
CLAUDE_SPOT_EXIT_POLL_SECONDS=5
CLAUDE_SPOT_MAX_ROUTE_LEGS=3
CLAUDE_SPOT_MAX_ROUTE_EXPANSIONS=10000
CLAUDE_SPOT_MAX_CANDIDATE_ROUTES=1
CLAUDE_SPOT_CANDIDATE_LIMIT=5
CLAUDE_SPOT_MARKET_PICK_MODE=small_market_aggressive
CLAUDE_SPOT_MIN_QUOTE_VOLUME_USDT=100000
CLAUDE_SPOT_MAX_SPREAD_BPS=50
CLAUDE_SPOT_SMALL_MIN_QUOTE_VOLUME_USDT=5000
CLAUDE_SPOT_SMALL_MAX_SPREAD_BPS=250
CLAUDE_SPOT_SMALL_CANDIDATE_LIMIT=10
CLAUDE_SPOT_SLIPPAGE_BUFFER_BPS=25
CLAUDE_SPOT_LEG_ROUNDING_RESERVE_BPS=5
CLAUDE_SPOT_MIN_LEG_QUOTE_RESERVE_BPS=25
CLAUDE_SPOT_TICKER_STALE_SECONDS=300
CLAUDE_SPOT_FEE_CACHE_SECONDS=60
CLAUDE_SPOT_MARKET_EVIDENCE_ENABLED=true
CLAUDE_SPOT_MARKET_EVIDENCE_LOOKBACK_HOURS=168
CLAUDE_SPOT_MARKET_EVIDENCE_MAX_SYMBOLS=12
CLAUDE_SPOT_MARKET_EVIDENCE_TIMEFRAME=1h
CLAUDE_SPOT_TRADE_MEMORY_LIMIT=8
CLAUDE_SPOT_TELEGRAM_EXPLAIN=true
CLAUDE_SPOT_TELEGRAM_REASON_CHARS=0
# Optional local Claude Spot scope. Allowed lists are strict when set. Fiat
# blocking keeps routes away from public fiat markets that can be visible in
# market data but rejected by some accounts for Spot API orders.
CLAUDE_SPOT_ALLOWED_SYMBOLS=
CLAUDE_SPOT_ALLOWED_ASSETS=
CLAUDE_SPOT_BLOCKED_SYMBOLS=
CLAUDE_SPOT_BLOCKED_ASSETS=
CLAUDE_SPOT_BLOCK_FIAT_ASSETS=true
CLAUDE_SPOT_BLOCKED_QUOTES=IDR

# Read-only social signal intelligence. Disabled by default. Telegram uses
# bot-visible updates only; X uses official API search only.
SOCIAL_SIGNAL_ENABLED=false
SOCIAL_SIGNAL_TELEGRAM_ENABLED=false
SOCIAL_SIGNAL_X_ENABLED=false
SOCIAL_SIGNAL_MODE=read_only
SOCIAL_SIGNAL_AUDIT_PATH=data/social-signals.jsonl
SOCIAL_SIGNAL_MAX_AGE_MINUTES=180
SOCIAL_SIGNAL_MIN_SOURCE_DIVERSITY=2
SOCIAL_SIGNAL_BLOCK_MANIPULATION_RISK=true
SOCIAL_SIGNAL_MANIPULATION_BLOCK_SCORE=0.8
SOCIAL_SIGNAL_MAX_RECORDS_PER_ASSET=12
SOCIAL_SIGNAL_TELEGRAM_BOT_TOKEN=
SOCIAL_SIGNAL_X_BEARER_TOKEN=
SOCIAL_SIGNAL_X_QUERY=
SOCIAL_SIGNAL_AI_ENABLED=false
SOCIAL_SIGNAL_AI_COMMAND=omp
SOCIAL_SIGNAL_AI_MODEL=sonnet
SOCIAL_SIGNAL_AI_TIMEOUT_SECONDS=120

# Phase 43 X pre-pump insighter (paper only; nothing here can trade). See
# docs/signals/x-insighter-design.md. The daemon (`bb x-insighter --daemon`, compose
# profile `x-insighter`) exits with a message unless X_INSIGHTER_ENABLED=true.
X_INSIGHTER_ENABLED=false
X_INSIGHTER_MAX_DAILY_LLM_COST_USD=0.50
X_INSIGHTER_OMP_COMMAND=omp
X_INSIGHTER_MODEL=haiku
X_INSIGHTER_HAIKU_TIMEOUT_SECONDS=120
# Read-only Camoufox X collector (compose profile `x-collector`, own image). It does
# not read this env file: compose passes it only the X_COLLECTOR_* values below
# (interpolated from the shell or the project .env). Lists and the burner session
# live in the data dir: x-accounts.txt, x-searches.txt, x-camoufox-profile/.
X_COLLECTOR_MAX_PAGES_PER_HOUR=120
X_COLLECTOR_MAX_REPLIES_PER_HOUR=400
X_COLLECTOR_POLL_SECONDS=300
X_COLLECTOR_FOCUS_POLL_SECONDS=180
X_COLLECTOR_HEADLESS=true

# Runtime behavior
LOG_LEVEL=INFO
FEED_QUEUE_MAXSIZE=1000
MARKET_DATA_MODE=polling
ORDER_UPDATE_MODE=disabled
# Minimum interval between repeated Telegram alerts for one WebSocket stream.
WS_ALERT_COOLDOWN_SECONDS=300

# SQLite database path for order and fill history
DB_PATH=data/bot.db

# Risk limits
MAX_POSITION_SIZE_USD=500
MAX_TOTAL_EXPOSURE_USD=
ALLOWED_LEVERAGE=
MAX_OPEN_ORDERS=
MAX_PRICE_DEVIATION_PCT=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Airdrop farming (scheduler + encrypted wallet store)
# Base dir for airdrop-wallets.json / airdrop-scheduler.json / airdrop-activity.json.
# Defaults to ~/.local/share/binance-bot/data (systemd). The docker image sets
# AIRDROP_DATA_DIR=/app/data so state lands on the persistent volume.
AIRDROP_DATA_DIR=
# Passphrase for the encrypted airdrop wallet store; when empty the CLI prompts.
AIRDROP_WALLET_PASSPHRASE=

# Backward-compatible aliases supported by Settings.from_env:
# BINANCE_SECRET_KEY, TRADE_QUANTITY, TIMEFRAME

# Modular asset-pool runtime (paper only; it never submits orders)
POOL_MODE=paper
POOL_DB_PATH=data/pool-paper.db
POOL_BENCHMARKS=USDT,BTC,PAXG,XAUT
POOL_BENCHMARK_WEIGHTS=0.25,0.25,0.25,0.25
POOL_MAX_ROUTE_LEGS=3
POOL_MAX_ROUTE_EXPANSIONS=10000
POOL_MAX_CANDIDATE_ROUTES=8
# 0 evaluates every asset represented in the eligible execution universe.
POOL_MAX_SCORING_ASSETS=0
POOL_MIN_QUOTE_VOLUME_USDT=100000
POOL_MAX_SPREAD_BPS=50
POOL_SLIPPAGE_BUFFER_BPS=25
POOL_TICKER_STALE_SECONDS=300
POOL_FEE_CACHE_SECONDS=60
POOL_BNB_FEE_BUFFER_MULTIPLIER=3
POOL_MIN_BNB_FEE_RESERVE=0.00005
POOL_SCORERS=simple_momentum,risk_adjusted_momentum
POOL_MOMENTUM_OBSERVATIONS=96
POOL_CYCLE_SECONDS=900
POOL_MAX_ALLOCATION_PERCENT=25
POOL_MAX_REALLOCATION_PERCENT=10
POOL_MIN_IMPROVEMENT_BPS=50
POOL_MAX_DRAWDOWN_PERCENT=10
POOL_DECISION_COOLDOWN_SECONDS=3600

# Claude access for omp (claude-spot, capital-pool --advise). Either set an API key
# here, or log in once interactively (`omp`, then /login); omp stores credentials
# under PI_CODING_AGENT_DIR (the docker image points it at /app/data/omp-agent).
ANTHROPIC_API_KEY=

# Capital pool: reserve + score-weighted per-module allocation with per-buy leases.
CAPITAL_POOL_ENABLED=false
CAPITAL_RESERVE_PCT=40
CAPITAL_MIN_MODULE_ALLOCATION_USD=0
CAPITAL_MAX_MODULE_ALLOCATION_USD=25
CAPITAL_POOL_STATE_FILE=data/capital-pool-state.json
# Claude allocation advisor (omp session). Proposals may only clamp the
# deterministic plan; any failure falls back to it.
CAPITAL_AI_ADVISOR_ENABLED=false
CAPITAL_AI_ADVISOR_FILE=
CAPITAL_AI_ADVISOR_TIMEOUT_SECONDS=8
CLAUDE_ALLOCATOR_OMP_COMMAND=omp
CLAUDE_ALLOCATOR_MODEL=sonnet
CLAUDE_ALLOCATOR_TIMEOUT_SECONDS=45
CLAUDE_ALLOCATOR_SESSION_DIR=data/claude-allocator-session

# Auto-convert: market-sell allowed assets into the quote to fund a buy shortfall.
AUTO_CONVERT_TO_QUOTE=false
AUTO_CONVERT_ASSETS=BNB
AUTO_CONVERT_MAX_QUOTE_USD=100
AUTO_CONVERT_MIN_QUOTE_USD=5
AUTO_CONVERT_BUFFER_PCT=1
AUTO_CONVERT_AUDIT_PATH=data/auto-convert-audit.jsonl

# Listing sniper (`bb listing-detector`, `bb listing-sniper`). Live fires need all of:
# LISTING_SNIPER_ENABLED=true, CONFIRM_LIVE_LISTING_SNIPER=yes, LISTING_SNIPER_PROVEN_EDGE=yes,
# USE_TESTNET=false, DRY_RUN=false.
LISTING_SNIPER_ENABLED=false
CONFIRM_LIVE_LISTING_SNIPER=no
LISTING_SNIPER_PROVEN_EDGE=no
LISTING_SNIPER_NOTIONAL_USDT=2
LISTING_SNIPER_DAILY_SPEND_CAP_USDT=10
LISTING_SNIPER_MIN_BALANCE_USDT=4
LISTING_WATCHLIST_PATH=data/listing-watchlist.json
