# Binance credentials
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Runtime mode
USE_TESTNET=true
DRY_RUN=false

# Set to "yes" only when switching to a real-money account.
CONFIRM_LIVE_TRADING=no

# Local API-key scope guard. Binance does not expose the full symbol whitelist
# through safe diagnostics, so live-capable features fail closed when a symbol
# or asset is outside these operator-owned lists.
API_SYMBOL_WHITELIST=
API_ASSET_WHITELIST=

# Bot agentic Spot trader (`bb bot-spot`). Disabled by default. The bot runs
# through omp in RPC mode with a persistent session (context survives restarts)
# and acts only through the bot's host tools. When live it may use the whole
# Spot wallet; there are no edge/friction/cooldown/daily-cap gates — costs are
# information the bot weighs. Hard safety always applies: the arming flags below,
# the stop file, Binance order/test before every leg, per-leg fill
# reconciliation, and the failed-route halt (clear with
# `bb bot-spot --mark-failed-route-reviewed`).
BOT_SPOT_ENABLED=false
BOT_SPOT_DYNAMIC_SCOPE=
BOT_SPOT_COMMAND=omp
# Use provider/model ids: a bare "gpt-6.1-sol" can resolve to another provider (e.g. github-copilot).
# Deployed: openai-codex/gpt-6.1-sol at high (operator decision 2026-10-16; was
# anthropic/claude-sonnet-5-5 from 2026-10-14, claude-haiku-5-5 before).
BOT_SPOT_MODEL=openai-codex/gpt-6.1-sol
# off, minimal, low, medium, high, xhigh, max
BOT_SPOT_THINKING=high
# omp built-in web_search alongside the bot's tools (news, catalysts). Results are untrusted data.
BOT_SPOT_WEB_SEARCH=true
BOT_SPOT_TIMEOUT_SECONDS=300
# Bot-owned model failover (empty = none). Comma list of
# provider/model-id[:thinking]; omitted thinking = BOT_SPOT_THINKING. A turn
# that failed (timeout, error, crash, rate/usage limit) WITHOUT an execute_route
# call is retried once per remaining model; a failed compaction moves to the next
# model too. Since 2026-10-19 (operator decision, docs/decisions.md) the trader runs on
# gpt-6.1-sol alone: the Gemini 4 Argon fallback was out of quota and was removed.
# Adding a fallback model needs a new operator decision.
BOT_SPOT_FALLBACK_MODELS=
# Primary per-attempt timeout while fallbacks exist (fallbacks use BOT_SPOT_TIMEOUT_SECONDS).
BOT_SPOT_PRIMARY_TIMEOUT_SECONDS=150
# Stay on a fallback this long, then try the primary again at the next cycle start.
BOT_SPOT_FALLBACK_COOLDOWN_SECONDS=1800
# Log an error after this many consecutive cycles failed on every model (0 = never).
BOT_SPOT_BRAIN_DOWN_ALERT_CYCLES=3
BOT_SPOT_PROMPT_VERSION=bot-spot-v17-schizo
BOT_SPOT_SESSION_DIR=data/bot-spot-session
BOT_SPOT_JOURNAL_PATH=data/bot-spot-journal.jsonl
BOT_SPOT_JOURNAL_PROMPT_ENTRIES=8
BOT_SPOT_STATE_PATH=data/bot-spot-agent-state.json
# Compact the omp session when context usage passes this percent of the model's window,
# or (BOT_SPOT_COMPACT_AT_TOKENS > 0) holds that many tokens, whichever comes first.
# The token threshold keeps one context size across models with 272K-1M windows. omp keeps
# recent messages after a compaction (the context came back at ~95-118K), so a 100K threshold
# compacted before nearly every cycle; 150K leaves room (2026-10-18).
BOT_SPOT_COMPACT_AT_PERCENT=70
BOT_SPOT_COMPACT_AT_TOKENS=150000
# LLM spend cap per UTC day in USD (0 = unlimited). Cost control, not a trading gate.
BOT_SPOT_MAX_DAILY_LLM_COST_USD=0
# Routes older than this are re-quoted before execute_route.
BOT_SPOT_ROUTE_STALE_SECONDS=60
BOT_SPOT_AUDIT_PATH=data/bot-spot-decisions.jsonl
BOT_SPOT_LOCK_PATH=data/bot-spot.lock
BOT_SPOT_STOP_PATH=data/bot-spot.stop
# Phase 45 exit-plan paper trial: plans set by the bot (set_exit_plan), and the
# state/log written by `bb bot-spot-exit-watch` (paper only, places no orders).
BOT_SPOT_EXIT_PLANS_PATH=data/bot-spot-exit-plans.json
BOT_SPOT_EXIT_WATCH_STATE_PATH=data/bot-spot-exit-watch-state.json
BOT_SPOT_EXIT_WATCH_LOG_PATH=data/bot-spot-exit-watch.jsonl
# Live exit plans (operator approval 2026-10-15): with --submit-live --daemon the trader
# follows the bid of every position with a plan between cycles and SELLS it into USDT when
# the plan fires (same hard safety as execute_route). false = paper (bot-spot-exit-watch).
BOT_SPOT_EXIT_PLANS_LIVE=false
# Plan for every position opened at or after ..._FROM unless the bot sets another (blank = none).
# Backtest winner 2026-10-15: sell all at the 2-sigma stretch, 3 x 1h ATR safety trail.
BOT_SPOT_DEFAULT_EXIT_PLAN=
BOT_SPOT_DEFAULT_EXIT_PLAN_FROM=
BOT_SPOT_EXIT_POLL_SECONDS=5
BOT_SPOT_MAX_ROUTE_LEGS=3
BOT_SPOT_MAX_ROUTE_EXPANSIONS=10000
BOT_SPOT_MAX_CANDIDATE_ROUTES=1
BOT_SPOT_CANDIDATE_LIMIT=5
BOT_SPOT_MARKET_PICK_MODE=small_market_aggressive
BOT_SPOT_MIN_QUOTE_VOLUME_USDT=100000
BOT_SPOT_MAX_SPREAD_BPS=50
BOT_SPOT_SMALL_MIN_QUOTE_VOLUME_USDT=5000
BOT_SPOT_SMALL_MAX_SPREAD_BPS=250
BOT_SPOT_SMALL_CANDIDATE_LIMIT=10
BOT_SPOT_SLIPPAGE_BUFFER_BPS=25
BOT_SPOT_LEG_ROUNDING_RESERVE_BPS=5
BOT_SPOT_MIN_LEG_QUOTE_RESERVE_BPS=25
BOT_SPOT_TICKER_STALE_SECONDS=300
BOT_SPOT_FEE_CACHE_SECONDS=60
BOT_SPOT_MARKET_EVIDENCE_ENABLED=true
BOT_SPOT_MARKET_EVIDENCE_LOOKBACK_HOURS=168
BOT_SPOT_MARKET_EVIDENCE_MAX_SYMBOLS=12
BOT_SPOT_MARKET_EVIDENCE_TIMEFRAME=1h
BOT_SPOT_TRADE_MEMORY_LIMIT=8
# Phase 49 (prompt bot-spot-v17-schizo): read GCP2 (gcp2.net, public, read-only) once per
# cycle and run the schizo trader: GCP2 mood ring (the mood switches when the GCP2 zone
# changes and holds while it stays the same), dice and persona votes in the
# prompts (`## Your schizo state`), audit field `schizo`, state persisted in
# bot-spot-schizo-state.json next to BOT_SPOT_STATE_PATH. A failed read (timeout, HTTP
# error, HTTP 429) means "GCP2 unavailable" for that cycle: the mood holds.
# false gives the v14 prompts (pair it with BOT_SPOT_PROMPT_VERSION=bot-spot-v14-agentic).
# The offline schizo backtest reads GCP2 history from `bb gcp2-history` (data/gcp2-cache);
# the trader does not.
BOT_SPOT_GCP2_ENABLED=true
BOT_SPOT_GCP2_BASE_URL=https://gcp2.net
# Phase 50 (prompt bot-spot-v17-schizo): the long-term value voice, a Markov model fitted by
# `bb bot-spot-mdp-fit` (γ=0.95 per 20-minute cycle). The trader reads the model file every
# cycle and shows `## Your long-term value` (audit field `mdp`); a missing file means "voice
# unavailable" that cycle. Information for the bot, never a gate.
BOT_SPOT_MDP_ENABLED=true
BOT_SPOT_MDP_MODEL_PATH=data/bot-spot-mdp.json
# Phase 51: the /biz/ feed (biz-feed-v1, written by biz-app on the laptop and copied here by
# scripts/biz_feed_to_pi.sh). Read every cycle and recorded in the cycle summary (audit field
# `biz`). The LLM prompt never shows it; only BOT_SPOT_DECIDER=algo trades on it. A missing file,
# another schema, or an as_of older than the age limit records "/biz/ unavailable" with the
# reason. Coins without an eligible Binance market are listed as dropped.
BOT_SPOT_BIZ_FEED_PATH=data/biz-feed.json
BOT_SPOT_BIZ_MAX_AGE_MINUTES=45
# Phase 51: who decides each cycle. llm (default) is the omp session; algo is the rule-based
# decider (crate::decider): no LLM is started, its buys and sells go through the same
# execute_route hard safety. Going live with algo needs a recorded operator decision (CODEX.md,
# Phase 51) after the bot-spot-algo-paper practice run. algo needs the weights
# talk,stance,momentum,value,buy_above,sell_below (e.g. from the biz_algo backtest).
BOT_SPOT_DECIDER=llm
# BOT_SPOT_ALGO_WEIGHTS=1,0.5,0.5,0,0.5,0
BOT_SPOT_ALGO_MIN_POSTERS=2
# Optional local Bot Spot scope. Allowed lists are strict when set. Fiat
# blocking keeps routes away from public fiat markets that can be visible in
# market data but rejected by some accounts for Spot API orders.
BOT_SPOT_ALLOWED_SYMBOLS=
BOT_SPOT_ALLOWED_ASSETS=
BOT_SPOT_BLOCKED_SYMBOLS=
BOT_SPOT_BLOCKED_ASSETS=
BOT_SPOT_BLOCK_FIAT_ASSETS=true
BOT_SPOT_BLOCKED_QUOTES=IDR

# Runtime behavior
LOG_LEVEL=INFO

# Alias still read for BINANCE_API_SECRET: BINANCE_SECRET_KEY

# Model access for omp (bot-spot). Either set an API key
# here, or log in once interactively (`omp`, then /login); omp stores credentials
# under PI_CODING_AGENT_DIR (the docker image points it at /app/data/omp-agent).
ANTHROPIC_API_KEY=
