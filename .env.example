# Binance credentials
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Runtime mode
USE_TESTNET=true
DRY_RUN=false

# Set to "yes" only when switching to a real-money account.
CONFIRM_LIVE_TRADING=no

# Local API-key scope guard. Binance does not expose the full symbol whitelist
# through safe diagnostics, so live-capable features fail closed when a symbol
# or asset is outside these operator-owned lists.
API_SYMBOL_WHITELIST=
API_ASSET_WHITELIST=

# Algorithm Spot trader (`bb bot-spot`). Disabled by default. No LLM: the
# operator's rule file (BOT_SPOT_ALGO_RULE below) decides. When live it may use the
# whole Spot wallet. Hard safety always applies: the arming flags below, the stop
# file, Binance order/test before every leg, per-leg fill reconciliation, the
# failed-route halt (clear with `bb bot-spot --mark-failed-route-reviewed`) and the
# sleeve_mismatch halt: sleeve holdings in the state file that cannot be read or exceed
# the free balance halt plan-only and live (clear with `bb bot-spot
# --mark-sleeves-reviewed` once they reconcile).
BOT_SPOT_ENABLED=false
BOT_SPOT_DYNAMIC_SCOPE=
# Cycle count and what each rule sleeve holds (strict load: unreadable halts).
BOT_SPOT_STATE_PATH=data/bot-spot-agent-state.json
# Routes older than this are re-quoted before execute_route.
BOT_SPOT_ROUTE_STALE_SECONDS=60
BOT_SPOT_AUDIT_PATH=data/bot-spot-decisions.jsonl
BOT_SPOT_LOCK_PATH=data/bot-spot.lock
BOT_SPOT_STOP_PATH=data/bot-spot.stop
BOT_SPOT_MAX_ROUTE_LEGS=3
BOT_SPOT_MAX_ROUTE_EXPANSIONS=10000
BOT_SPOT_MAX_CANDIDATE_ROUTES=1
BOT_SPOT_CANDIDATE_LIMIT=5
BOT_SPOT_MARKET_PICK_MODE=small_market_aggressive
BOT_SPOT_MIN_QUOTE_VOLUME_USDT=100000
BOT_SPOT_MAX_SPREAD_BPS=50
BOT_SPOT_SMALL_MIN_QUOTE_VOLUME_USDT=5000
BOT_SPOT_SMALL_MAX_SPREAD_BPS=250
BOT_SPOT_SMALL_CANDIDATE_LIMIT=10
BOT_SPOT_SLIPPAGE_BUFFER_BPS=25
BOT_SPOT_LEG_ROUNDING_RESERVE_BPS=5
BOT_SPOT_MIN_LEG_QUOTE_RESERVE_BPS=25
BOT_SPOT_TICKER_STALE_SECONDS=300
BOT_SPOT_FEE_CACHE_SECONDS=60
BOT_SPOT_TRADE_MEMORY_LIMIT=8
# The tags feed (tags-feed-v1, written by biz-app; on the Pi by the biz-feed systemd user unit,
# deploy/seref/biz-feed.service). Read every tick and summarised on each decision row (audit
# field `tags`); the algorithm scores the asset tags of the coins it may buy. A missing file,
# another schema, or an as_of older than the age limit records "tags unavailable" with the
# reason. Asset tags without an eligible Binance market or proxy are listed as scored_only.
BOT_SPOT_TAGS_FEED_PATH=data/tags-feed.json
BOT_SPOT_TAGS_MAX_AGE_MINUTES=45
# The operator's proxy file: asset tags without a Spot market of their own reach these
# markets and make them buy candidates (operator, 2026-10-30: gold through PAXG and XAUT).
# Unset: no proxies. Set but missing or invalid: the trader refuses to start. In the Docker
# image the shipped file is /app/config/proxies.json (relative path config/proxies.json).
BOT_SPOT_PROXIES=config/proxies.json
# The algorithm's rule file (crate::rules), required: rules_version (recorded on every audit
# row with the file's sha256), style "fixed" (weights by signal name, crate::signals) or
# "edge" (weights from the tag scoreboard, edge_scoreboard), and per sleeve its share,
# horizon filter, defensive assets, risk-off level, buy and sell levels and poster minimum.
# Each sleeve with a share or a holding decides on its own: buys spend its share of the
# portfolio value (capped at the free USDT), sells exactly its quantity. A missing file, an
# unknown signal, shares not summing to 1 or sell_below above buy_above: the trader refuses
# to start. Its buys and sells go through the execute_route hard safety.
# config/rules/algo-2026-10-29.json is the rule the operator chose on 2026-10-29
# (docs/decisions.md, "2026-10-29 algorithm rules"): fast sleeve, share 1, talk.6h 0,
# stance.6h 1, momentum.1h 1, buy at +0.5, sell below -0.5, 2 posters; core sleeve share 0.
# In the Docker image: /app/config/rules/algo-2026-10-29.json.
BOT_SPOT_ALGO_RULE=config/rules/algo-2026-10-29.json
# Optional local Bot Spot scope. Allowed lists are strict when set. Fiat
# blocking keeps routes away from public fiat markets that can be visible in
# market data but rejected by some accounts for Spot API orders.
BOT_SPOT_ALLOWED_SYMBOLS=
BOT_SPOT_ALLOWED_ASSETS=
BOT_SPOT_BLOCKED_SYMBOLS=
BOT_SPOT_BLOCKED_ASSETS=
BOT_SPOT_BLOCK_FIAT_ASSETS=true
BOT_SPOT_BLOCKED_QUOTES=IDR

# Runtime behavior
LOG_LEVEL=INFO

# Alias still read for BINANCE_API_SECRET: BINANCE_SECRET_KEY
