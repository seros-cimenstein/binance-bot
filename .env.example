BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
TRADING_SYMBOL=BTC/USDT
LOG_LEVEL=INFO

# Telegram alerts (get token from @BotFather, chat_id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to "yes" only when switching to a real-money account
USE_TESTNET=true
CONFIRM_LIVE_TRADING=no

# SQLite database path for order history and daily loss persistence
DB_PATH=data/bot.db

# Risk limits
MAX_POSITION_SIZE_USD=500
DAILY_LOSS_LIMIT_USD=100

# Set to true to log signals without submitting orders
DRY_RUN=false
